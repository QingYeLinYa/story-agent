{
  "name": "story-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "smoke": "tsx server/smoke-check.ts",
    "index": "tsx server/retrieval/cli.ts",
    "vector:up": "docker compose up -d chroma",
    "vector:up:milvus": "docker compose --profile milvus up -d"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.2.10",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@zilliz/milvus2-sdk-node": "^3.0.5",
    "better-sqlite3": "^13.0.3",
    "chromadb": "^3.5.0",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
